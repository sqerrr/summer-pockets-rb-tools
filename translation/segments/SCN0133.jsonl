{"id": "SEG_S0163_R000011_G00", "source_set_id": "SPRB_STEAM_LUCA", "source_id": "SRC_LUCA_E000168_R000011_G00", "source_hash": "sha256:0a0a055d5bba26de83ea1880096d4115f5de03dc9a5d5aa5dd63942aa24d8f50", "file_id": "S0163", "scene_id": "SCN0133", "order": 1, "speaker": "配達員", "translation": "Вам посылка-а!", "status": "draft", "flags": [], "confidence": "high"}
