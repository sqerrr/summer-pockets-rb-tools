{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VN Style Pipeline Event",
  "type": "object",
  "required": ["schema_version", "event"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "event": {
      "enum": [
        "ledger_initialized",
        "run_started",
        "window_applied",
        "window_revised",
        "window_accepted",
        "style_keep_reverted",
        "style_siblings_reconciled",
        "style_run_retired",
        "style_retirement_annotated",
        "run_completed",
        "route_audited",
        "build_readback"
      ]
    },
    "run_id": {"type": "string", "pattern": "^STYLE-BLK[0-9]{4}-[0-9]{2}$"},
    "route": {"type": "string", "pattern": "^BLK[0-9]{4}$"},
    "window_id": {"type": "string", "pattern": "^W[0-9]{3}$"},
    "changes": {"type": "array"},
    "decisions": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "style_run_retired"}}},
      "then": {
        "required": [
          "run_id", "route", "mode", "actor", "reason", "request_sha256",
          "input_route_sha256", "manifest_sha256", "decisions", "changes",
          "result_route_sha256"
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "style_retirement_annotated"}}},
      "then": {"required": ["run_id", "manifest_sha256", "annotations"]}
    }
  ],
  "additionalProperties": true
}
