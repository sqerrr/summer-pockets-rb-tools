{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VN Style Pipeline Event",
  "type": "object",
  "required": ["schema_version", "event"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "event": {
      "enum": [
        "ledger_initialized",
        "run_started",
        "window_applied",
        "window_revised",
        "window_accepted",
        "style_keep_reverted",
        "style_siblings_reconciled",
        "style_run_retired",
        "style_retirement_annotated",
        "window_proofread",
        "run_completed",
        "route_audited",
        "build_readback"
      ]
    },
    "run_id": {"type": "string", "pattern": "^STYLE-BLK[0-9]{4}-[0-9]{2}$"},
    "route": {"type": "string", "pattern": "^BLK[0-9]{4}$"},
    "window_id": {"type": "string", "pattern": "^W[0-9]{3}$"},
    "blocker_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SSB-[0-9a-f]{16}$"},
      "uniqueItems": true
    },
    "resolutions": {"type": "array"},
    "reverts": {"type": "array"},
    "changes": {"type": "array"},
    "decisions": {"type": "array"},
    "issues": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "style_keep_reverted"}}},
      "then": {
        "required": [
          "run_id", "window_id", "actor", "reason", "request_sha256",
          "input_sha256", "reverts", "changes", "result_delta_sha256"
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "style_siblings_reconciled"}}},
      "then": {
        "required": [
          "run_id", "route", "actor", "input_sha256", "patch_sha256",
          "blocker_ids", "resolutions", "changes", "result_route_sha256"
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "style_run_retired"}}},
      "then": {
        "required": [
          "run_id", "route", "mode", "actor", "reason", "request_sha256",
          "input_route_sha256", "manifest_sha256", "decisions", "changes",
          "result_route_sha256"
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "style_retirement_annotated"}}},
      "then": {
        "required": ["run_id", "manifest_sha256", "annotations"]
      }
    },
    {
      "if": {"properties": {"event": {"const": "window_proofread"}}},
      "then": {
        "required": [
          "run_id", "window_id", "reviewer", "input_sha256",
          "report_sha256", "issues"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 4},
          "event": {"const": "window_applied"}
        }
      },
      "then": {
        "required": [
          "run_id", "window_id", "input_sha256", "patch_sha256",
          "quarantine_resolutions", "changes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 4},
          "event": {"const": "run_started"}
        }
      },
      "then": {
        "required": ["run_id", "route", "route_sha256", "segment_count", "finalization_mode", "windows"],
        "properties": {"finalization_mode": {"const": "tep"}}
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 4},
          "event": {"const": "window_revised"}
        }
      },
      "then": {
        "required": [
          "run_id", "window_id", "actor", "report_sha256", "input_sha256",
          "patch_sha256", "resolutions", "changes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 4},
          "event": {"const": "window_accepted"}
        }
      },
      "then": {
        "required": ["run_id", "window_id", "acceptance_mode", "final_delta_sha256"],
        "properties": {
          "acceptance_mode": {"enum": ["tep_zero_issue", "tep_after_fix"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 3},
          "event": {"const": "window_accepted"}
        }
      },
      "then": {
        "required": [
          "run_id", "window_id", "acceptance_mode", "reviewer",
          "input_sha256", "report_sha256", "decisions", "changes",
          "final_delta_sha256"
        ],
        "properties": {
          "acceptance_mode": {"const": "comparative"}
        }
      }
    }
  ],
  "additionalProperties": true
}
