{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VN External Reference Fragment",
  "type": "object",
  "required": [
    "id",
    "corpus",
    "location",
    "lines",
    "situation",
    "function",
    "technique",
    "selection_reason",
    "applicability",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REF-[A-Za-z0-9_-]+$"
    },
    "corpus": {"type": "string"},
    "location": {
      "type": "object",
      "required": ["scene", "start", "end"],
      "properties": {
        "scene": {"type": "string"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["order", "speaker", "translation_ru"],
        "properties": {
          "order": {"type": "integer", "minimum": 0},
          "speaker": {"type": ["string", "null"]},
          "source": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "translation_ru": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "situation": {"type": "string"},
    "function": {
      "description": "Free description of what the fragment does. Use an array when several registers genuinely coexist; do not force a single label.",
      "type": ["string", "array"],
      "items": {"type": "string"}
    },
    "technique": {"type": "string"},
    "carrier": {
      "description": "Что физически несёт эффект: ритм реплик, повествование, молчание, повтор, контраст длины, столкновение регистров. Список открытый, не таксономия.",
      "type": "array",
      "items": {"type": "string"}
    },
    "context_dependency": {
      "description": "Насколько приём читается в отрыве от истории. Определяет силу фрагмента как доказательства для другого произведения.",
      "enum": ["standalone", "needs_scene", "needs_history"]
    },
    "selection_reason": {"type": "string"},
    "applicability": {"type": "string"},
    "status": {
      "enum": ["raw", "usable", "gold", "rejected"]
    },
    "rejection_reason": {"type": "string"}
  },
  "additionalProperties": false
}
