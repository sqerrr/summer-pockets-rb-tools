{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VN Translation Segment",
  "type": "object",
  "required": [
    "id",
    "source_set_id",
    "source_id",
    "source_hash",
    "file_id",
    "scene_id",
    "order",
    "translation",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "file_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "speaker": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "description": "Optional hydrated working-language source. Prefer source_id in persisted project data."
    },
    "sources": {
      "type": "object",
      "description": "Optional hydrated aligned sources generated from the local source catalogue.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "translation": {
      "type": "string",
      "description": "Canonical direct-Unicode Russian. Engine encoding is applied only during build."
    },
    "status": {
      "enum": [
        "todo",
        "draft",
        "reviewed",
        "playable",
        "approved",
        "lqa"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array"
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
