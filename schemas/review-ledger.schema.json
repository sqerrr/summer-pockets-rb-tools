{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VN Scene Review Event",
  "type": "object",
  "required": ["schema_version", "event"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "event": {
      "enum": [
        "ledger_initialized",
        "review_imported",
        "review_resolved",
        "review_rechecked",
        "review_accepted",
        "review_issue_superseded",
        "review_issue_reverted",
        "review_invalidated",
        "review_finalization_blocked",
        "review_run_superseded"
      ]
    },
    "review_id": {"type": "string", "pattern": "^REV-SCN[0-9]{4}-[0-9]{2}$"},
    "scene_id": {"type": "string", "pattern": "^SCN[0-9]{4}$"}
  },
  "additionalProperties": true
}
